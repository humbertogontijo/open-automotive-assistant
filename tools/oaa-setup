#!/usr/bin/env bash
# Open Automotive Assistant — host-side setup (build / sign / install / permissions).
#
# Usage:
#   ./tools/oaa-setup [--integration antora1000] [--host IP] [--user N] [--full] <command>
#
# Commands:
#   connect              adb connect to the HU
#   build                gradle :app:assembleDebug (arm64 only)
#   sign                 sign APK with community testkey (:signing:signApk)
#   install              /data install + runtime grants. Pushes only a delta against
#                        the installed build when it is in ~/.cache/oaa/apks;
#                        --full (or OAA_FULL=1) always pushes the whole APK
#   grant                grant runtime car/camera permissions for the Android user
#   check                print permission / package status
#   setup                connect → build → sign → install → grant → check
#   uninstall            remove the package
#   start                launch MainActivity for the target user
#   pair                 mint a car API token over adb for host scripts (the car's
#                        :8787 API needs a paired device or token, ADR-0004)
#   hub-deploy [--node ID|--all] [--no-build] [--no-wait] [--allow-newer]
#                        build → sign → upload to the hub → OTA rollout (no adb;
#                        needs OAA_HUB_URL and OAA_HUB_TOKEN or OAA_HUB_USER).
#                        Refuses an APK newer than the hub unless --allow-newer
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/common.sh
source "$ROOT/tools/lib/common.sh"
# shellcheck source=lib/permissions.sh
source "$ROOT/tools/lib/permissions.sh"
# shellcheck source=lib/install.sh
source "$ROOT/tools/lib/install.sh"
# shellcheck source=lib/hub.sh
source "$ROOT/tools/lib/hub.sh"

INTEGRATION="${OAA_INTEGRATION:-antora1000}"
HOST="${OAA_HOST:-}"
ANDROID_USER="${OAA_USER:-}"
CMD=""

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed -E 's/^# ?//'
  echo
  echo "Integrations:"
  for f in "$ROOT/integrations"/*/host.sh; do
    [[ -f "$f" ]] && basename "$(dirname "$f")"
  done | sed 's/^/  /'
  echo
  echo "Device commands require --host / -H CAR_IP (or OAA_HOST). hub-deploy uses OAA_HUB_URL instead."
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --integration|-i) INTEGRATION="$2"; shift 2 ;;
    --host|-H) HOST="$2"; shift 2 ;;
    --user|-u) ANDROID_USER="$2"; shift 2 ;;
    --full) OAA_FULL=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "Unknown flag: $1" ;;
    *) CMD="$1"; shift; break ;;
  esac
done

EXTRA=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--full" ]]; then OAA_FULL=1; else EXTRA+=("$1"); fi
  shift
done
load_integration "$INTEGRATION"

# CLI overrides
[[ -n "$HOST" ]] && OAA_HOST="$HOST"
[[ -n "$ANDROID_USER" ]] && OAA_ANDROID_USER="$ANDROID_USER"

case "${CMD:-}" in
  connect)
    oaa_connect
    ;;
  build)
    oaa_build
    ;;
  sign)
    oaa_sign
    ;;
  install)
    oaa_connect
    oaa_ensure_apk
    oaa_install_data
    oaa_grant_runtime
    oaa_check
    ;;
  grant)
    oaa_connect
    oaa_grant_runtime
    oaa_check
    ;;
  check)
    oaa_connect
    oaa_check
    ;;
  setup)
    oaa_connect
    oaa_build
    oaa_sign
    oaa_install_data
    oaa_grant_runtime
    oaa_check
    log "Telemetry-ready (user-space /data install)."
    ;;
  uninstall)
    oaa_connect
    oaa_uninstall
    ;;
  start)
    oaa_connect
    oaa_start
    ;;
  pair)
    oaa_connect
    oaa_pair
    ;;
  hub-deploy)
    hub_deploy "${EXTRA[@]+"${EXTRA[@]}"}"
    ;;
  "" )
    usage
    exit 1
    ;;
  *)
    die "Unknown command: $CMD"
    ;;
esac
