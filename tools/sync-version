#!/usr/bin/env python3
"""Copy oaa.version from gradle.properties into the non-Gradle manifests.

Usage:
  tools/sync-version          rewrite the files
  tools/sync-version --check  exit 1 if any file is out of date (CI)
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def gradle_version() -> str:
    for line in (ROOT / "gradle.properties").read_text().splitlines():
        m = re.match(r"\s*oaa\.version\s*=\s*(\S+)", line)
        if m:
            return m.group(1)
    sys.exit("oaa.version missing from gradle.properties")


def sub_line(pattern: str, replacement: str):
    rx = re.compile(pattern, re.MULTILINE)

    def apply(text: str, version: str) -> str:
        new, n = rx.subn(replacement.format(version=version), text, count=1)
        if n != 1:
            raise ValueError(f"pattern not found: {pattern}")
        return new

    return apply


TARGETS = {
    "deploy/homeassistant/open_automotive_assistant/config.yaml": sub_line(r'^version: ".*"$', 'version: "{version}"'),
    "homeassistant/custom_components/open_automotive_assistant/manifest.json": sub_line(r'^  "version": ".*",$', '  "version": "{version}",'),
    "docs/openapi/open-automotive-assistant-v1.yaml": sub_line(r"^  version: .*$", "  version: {version}"),
}


def main() -> int:
    check = "--check" in sys.argv[1:]
    version = gradle_version()
    stale = []
    for rel, apply in TARGETS.items():
        path = ROOT / rel
        text = path.read_text()
        new = apply(text, version)
        if new == text:
            continue
        stale.append(rel)
        if not check:
            path.write_text(new)
    if check and stale:
        print(f"version {version} not synced in: " + ", ".join(stale) + " (run tools/sync-version)")
        return 1
    for rel in stale:
        print(f"updated {rel} -> {version}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
